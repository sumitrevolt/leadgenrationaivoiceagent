# ==== Buzz relay — LOCAL dev env (generated by buzz-local-up.sh; gitignored) ====
# Copy to deploy/buzz/env/.env.local and fill CHANGE_ME, or let buzz-local-up.sh generate it.
# Local relay on port 3000 (loopback only).

BUZZ_IMAGE=ghcr.io/block/buzz:main

# Local host values (http/ws, not https/wss). Use 127.0.0.1, not localhost —
# agents canonicalize localhost → 127.0.0.1 and the relay keys the community on
# the exact RELAY_URL, so a mismatch = NIP-98 401s.
BUZZ_DOMAIN=localhost
RELAY_URL=ws://127.0.0.1:3000
BUZZ_MEDIA_BASE_URL=http://127.0.0.1:3000/media
BUZZ_MEDIA_SERVER_DOMAIN=127.0.0.1
BUZZ_CORS_ORIGINS=http://127.0.0.1:3000

# Closed local relay — requires owner pubkey + stable relay key.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
# Serve the web UI locally too (http://127.0.0.1:3000/)
BUZZ_SERVE_GIT_WEB_GUI=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity — 64-char hex Nostr pubkey (buzz-admin generate-key output)
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets — generate once, keep, back up
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY  # pragma: allowlist secret
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX  # pragma: allowlist secret
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD  # pragma: allowlist secret
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD  # pragma: allowlist secret
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY  # pragma: allowlist secret
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY  # pragma: allowlist secret
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

# Ports — 3000 locally (loopback only)
BUZZ_HTTP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# AI Voice Agent - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="AI Voice Agent"
APP_ENV=development  # development, staging, production
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-secret-key-do-not-use-in-production-32c

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voice_agent_db
REDIS_URL=redis://localhost:6379/0
# Evictable cache only (app.cache.Cache) — alag Redis instance taaki high-volume
# cache writes broker/call-state wali REDIS_URL (noeviction) ko fill na karein.
# UNSET = REDIS_URL fallback (backwards-compatible). VPS compose me redis-cache set.
CACHE_REDIS_URL=
# Schema mgmt (audit P2): 1 (default) = boot pe create_all + idempotent column-ALTERs.
# Alembic migrations live-DB ke against verify hone ke BAAD 0 set karo (Alembic-only).
DB_CREATE_ALL=0  # Prod: Alembic-only. Dev: =1 for convenience.
# Request guard (audit): per-request timeout (504) + per-worker in-flight load-shed (503).
# Default OFF (zero change). Staging pe test karke ON karo. Long/ws/streaming paths skip.
REQUEST_GUARD=0
REQUEST_TIMEOUT_S=55
REQUEST_MAX_INFLIGHT=200
# REQUEST_GUARD_SKIP=/ws,/health,/metrics,/api/web-call,/api/voiceai,/agents/coordinate,/api/agents/run,/api/ml,/api/ai

# ===========================================
# AI MODELS - Configure at least one LLM
# ===========================================
# Google Gemini (Recommended - best value for India)
GEMINI_API_KEY=your-gemini-api-key
# Optional: 2-3 Gemini keys (comma-separated) for quota rotation — STT+LLM share
# one key's free quota, so backup keys keep the phone agent alive when one runs out.
GEMINI_API_KEYS=

# Free OpenAI-compatible providers (NO credit card) — Gemini quota backup for the
# phone agent. STT: Groq whisper-large-v3. LLM chain: Cerebras -> Groq -> OpenRouter.
# All OPTIONAL — app boots fine with these empty (see app/voice_agent/free_ai.py).
GROQ_API_KEY=          # free: https://console.groq.com  (whisper-large-v3 STT + llama-3.3-70b)
CEREBRAS_API_KEY=      # free: https://cloud.cerebras.ai  (llama-3.3-70b, fastest)
OPENROUTER_API_KEY=    # free: https://openrouter.ai      (deepseek/deepseek-chat:free)
# NVIDIA NIM (OpenAI-compatible) — free-tier DEEP-TAIL fallback. 40 RPM + metered credits
# (~1k-5k lifetime), so it only fires when the unlimited primaries are all down.
NVIDIA_API_KEY=        # free: https://build.nvidia.com   (nvapi-... key)
# NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_PRIMARY=0     # 1 = put NVIDIA at chain HEAD (NOT recommended: 40 RPM + credit cap + latency)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1

# OpenAI (Alternative)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# DEFAULT_LLM: KHALI chhodo — code-defaults sahi hain. Yeh set karne se
# free_ai.py ka Gemini voice-model override + structured-LLM default badal jata
# hai (2026-07-05 cleanup: pehle yahan stale gemini-1.5-flash tha, jo copy hote
# hi voice agent ko deprecated model pe le jata).
DEFAULT_LLM=

# ===========================================
# SPEECH-TO-TEXT / TEXT-TO-SPEECH — FREE stack only (user mandate, koi paid nahi)
# ===========================================
# STT: Groq whisper-large-v3 (GROQ_API_KEY upar) primary + Gemini audio fallback
#      + optional baked local Hinglish whisper (HINGLISH_STT niche).
# TTS: EdgeTTS hi-IN-SwaraNeural (FREE, built-in default; edge-tts>=7.2.0 warna 403).
# (Deepgram/ElevenLabs/Azure keys 2026-07-05 removed — stack se kab ke hat chuke the,
#  code me kahin read nahi hote.)

# ===========================================
# TELEPHONY (Required - choose one)
# ===========================================
# Twilio (International)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/twilio

# Vobiz (India-native SIP trunk + voice API — primary trunk for India calls)
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_CALLER_ID=+91XXXXXXXXXX  # registered 140-series DID
VOBIZ_TRUNK_ID=your-vobiz-trunk-id
VOBIZ_TRUNK_DOMAIN=your-vobiz-sip-domain

# Voice TTS prosody — natural pacing + warmth for phone calls
#   +26% = snappier, more confident pace (2026-07-03: bumped from +8%, which
#          real callers reported as noticeably slow — matches the web-call
#          rate that was already tuned to +26% for the same complaint)
#   +2Hz = slightly warmer female tone
PHONE_TTS_RATE=+26%
PHONE_TTS_PITCH=+2Hz

# Gemini as PRIMARY LLM for voice (better Hinglish, larger context, more nuanced)
#   0 = free-AI chain primary (Cerebras→Groq→OpenRouter), Gemini fallback
#   1 = Gemini primary, free-AI fallback
VOICE_GEMINI_PRIMARY=1

DEFAULT_TELEPHONY=vobiz  # vobiz, twilio

# ===========================================
# LEAD SCRAPING
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
PROXY_URL=http://user:pass@proxy:port
USE_PROXY=false

# ===========================================
# CRM INTEGRATIONS
# ===========================================
# HubSpot
HUBSPOT_API_KEY=your-hubspot-api-key

# Zoho CRM
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=path/to/credentials.json
DEFAULT_SPREADSHEET_ID=your-spreadsheet-id

# ===========================================
# WHATSAPP BUSINESS API
# ===========================================
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# --- Provider switch: "cloud" (Meta Cloud API, default) OR "waha" (own self-hosted stack) ---
# A number is EITHER on Cloud API OR on a Web-session stack — never both at once.
WHATSAPP_PROVIDER=cloud
WHATSAPP_BUSINESS_NUMBER=918261030181   # linked business number (digits, with country code)

# --- Self-hosted WhatsApp stack (WAHA Core) — sidesteps Meta Business VERIFICATION ---
# Run the container: docker compose -f docker-compose.waha.yml up -d  (see that file's header)
# Then link the number once by scanning the QR (admin panel /app/whatsapp -> Self-host card).
# ⚠️ BAN-RISK: a Web session has NO template/24h protection — use for INBOUND auto-reply +
#    warm 1-to-1 + low-volume opt-in only. Bulk cold-blasting bans the number fast.
WAHA_BASE_URL=                 # e.g. http://waha:3000 (in-network). Empty = self-host inert.
WAHA_API_KEY=                  # X-Api-Key shared with the WAHA container (WAHA_API_KEY there)
WAHA_SESSION=default           # session name holding the linked number
WAHA_WEBHOOK_TOKEN=            # secret in the WAHA->app webhook URL (?token=...). Set in prod.

# ===========================================
# EMAIL NOTIFICATIONS
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
# Owner-alert target (telephony readiness drops, staff-agent alerts etc.) —
# khali = email alerts skip, ntfy hi bachta hai. (audit 2026-07-05: was undocumented)
NOTIFY_EMAIL=

# ===========================================
# COMPLIANCE (India-specific)
# ===========================================
DND_API_URL=https://api.dnd-check.in
DND_API_KEY=your-dnd-api-key
ENABLE_DND_CHECK=true

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================
SENTRY_DSN=https://your-sentry-dsn
# Optional bearer-token gate on /metrics + /health/deep (production audit
# 2026-07-01) — empty = today's open behavior unchanged (internal Prometheus
# scraping has no token). Set to lock down external exposure of real
# business/operational counts; if armed, monitoring/prometheus.yml's
# leadgen-app scrape job needs the SAME value (see its comment) or it 401s.
METRICS_TOKEN=

# ===========================================
# OFFSITE BACKUP (VPS host cron, not the app itself — scripts/pg_backup.sh +
# scripts/data_backup_rclone.sh read this from the VPS's own .env, not this
# app process's env). Empty = offsite disabled, local-only backups still run.
# Setup for R2 / B2 / Google Drive (incl. Drive's one-time OAuth step):
# deploy/offsite/rclone.conf.example
# ===========================================
RCLONE_REMOTE=

# ===========================================
# CALL SETTINGS
# ===========================================
MAX_CALL_DURATION_SECONDS=300
MAX_CONCURRENT_CALLS=10
CALL_RETRY_ATTEMPTS=3
CALL_RETRY_DELAY_MINUTES=30
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00
TIMEZONE=Asia/Kolkata

# ===========================================
# SUPPORT CONTACT SETTINGS
# ===========================================
SUPPORT_PHONE_NUMBER=+919876543210
SUPPORT_WHATSAPP_NUMBER=+919876543210
SUPPORT_EMAIL=support@leadgenai.com
PLATFORM_WEBSITE_URL=https://app.leadgenai.com

# ===========================================
# PLATFORM SETTINGS
# ===========================================
AUTO_START_PLATFORM=false  # Set to true in production
PLATFORM_COMPANY_NAME=LeadGen AI Solutions

# ===========================================
# SUBSCRIPTION PRICING (INR)
# ===========================================
# NOTE: Plan prices are NOT read from env. Single source of truth = app/packages.py
# (Marketing) + app/voice_packages.py (Voice). /billing/plans sync se aate hain.
# Inhe yahan set karne se kuch nahi hota (legacy keys, code me unused).
TRIAL_DURATION_DAYS=7
TRIAL_CALLS_LIMIT=100

# ===========================================
# PAYMENT GATEWAYS
# ===========================================
# Stripe (International payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay removed 2026-06-18 — no online India gateway (payments via manual UPI).

# Manual UPI = PRIMARY payment path (India). VPA set => /api/public/pay-info
# enabled + payment modal QR/intent live. Khali = UPI flow dormant.
# (audit 2026-07-05: was undocumented — revenue-critical key)
UPI_VPA=
# GST sirf REGISTERED hone par — GSTIN set = invoices me GST line, unset = 0% (correct
# for unregistered <₹20L services). (audit 2026-07-05: was undocumented)
GST_GSTIN=

# Payment Settings
DEFAULT_CURRENCY=INR
AUTO_DETECT_PAYMENT_GATEWAY=true

# ===========================================
# JWT / AUTHENTICATION (Required)
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-jwt-secret-key-do-not-use-in-prod-32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# SECURITY
# ===========================================
CORS_ORIGINS=["https://app.yourdomain.com","http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=100
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
# Admin-surface hard gate (middleware): set => /api/admin* requests need this
# API key header ke saath. Khali = middleware gate off (JWT auth hi bachta hai).
# (audit 2026-07-05: was undocumented — security-critical)
ADMIN_API_KEY=
# Admin login 2FA: TOTP secret set => admin login me 6-digit code required.
# Generate: scripts/ ke totp helper ya authenticator app se. Khali = 2FA off.
# (audit 2026-07-05: was undocumented — security-critical)
ADMIN_TOTP_SECRET=
# External scheduler-recovery tick (/api/platform/team/run-due Bearer token) —
# khali = recovery endpoint dormant (CLAUDE.md known-pending).
# (audit 2026-07-05: was undocumented)
LEADGEN_SCHEDULER_SECRET=

# ===========================================
# GOOGLE CLOUD STORAGE
# ===========================================
GCS_BUCKET_NAME=auraleads-storage
GCS_PROFILE_PICTURES_BUCKET=auraleads-profile-pictures

# ===========================================
# ===== LEAD DELIVERY =====
# Qualified lead aane par usse saare channels par auto-deliver karta hai.
# Har flag true rakho — jiska key/credential configured hoga wahi actually
# bhejega, baaki channel apne aap "skipped (not configured)" ho jayega.
# Kisi ek channel ko band karna ho to uska flag false kar do.
# ===========================================
DELIVERY_WHATSAPP_ENABLED=true   # WhatsApp par client ko lead alert bhejo
DELIVERY_SHEETS_ENABLED=true     # Google Sheet me lead row append karo
DELIVERY_HUBSPOT_ENABLED=true    # HubSpot me contact (+ optional deal) banao
DELIVERY_EMAIL_ENABLED=true      # Client ko email par lead bhejo

# Default notify target — jab client_config me number/email na ho to yahan
# diya gaya WhatsApp number ya email use hoga (fallback). Khaali bhi chhod sakte ho.
CLIENT_NOTIFY_DEFAULT=

# ===========================================
# ===== CRM SYNC =====
# Qualified leads ko Zoho/HubSpot me auto-push. CRM_SYNC=1 + credentials.
# ===========================================
CRM_SYNC=0  # 1 = ON (auto-hook on call_qualifier qualified=true)

# Zoho CRM (India DC) — per-client config preferred, yeh global fallback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in  # in | us | eu | cn | au

# HubSpot CRM — global fallback (per-client token bhi supported)
HUBSPOT_API_KEY=

# ===========================================
# ===== FLOW RUNNER (Workflow Engine) =====
# Formal workflow automation: state machines, pause/resume, replay.
# ===========================================
FLOW_RUNNER=0  # 1 = ON (flow_store + flow_compiler + dag_engine active)
FLOW_AUTO_TRIGGERS=0  # 1 = auto-scan triggers for registered flows
# Unified TelephonyService ke liye (plug-and-play calling).
#
# TELEPHONY_PROVIDER: kaunsa provider use karna hai. Options:
#   twilio | sip | none   (Exotel DELETED 2026 — ADR-005; primary trunk = Vobiz upar)
#   - Khali chhodo ya 'none' => SIMULATION mode (koi key nahi chahiye; poora
#     pipeline end-to-end test ho jata hai, real call nahi lagti).
#   - Khali rakhne par auto-detect bhi hota hai: jis provider ki keys mili wahi
#     use hoga (priority: sip -> twilio).
# ===========================================
TELEPHONY_PROVIDER=

# SIP trunk = SABSE SASTA option (~₹0.40/min India me). Provider se trunk + DID lo
# (Plivo / Exotel SIP / FreJun / MyOperator etc.) aur niche ki values bharo.
SIP_HOST=             # SIP registrar/proxy host (ya provider REST API base / Asterisk ARI host)
SIP_USERNAME=         # SIP trunk auth username
SIP_PASSWORD=         # SIP trunk auth password
SIP_DID=              # DID number jo caller-id me dikhega (E.164 ya 10-digit)
SIP_PROVIDER=         # optional REST slug: plivo | frejun | generic.
                      # Set karoge to handler us provider ki REST API se call originate karega.
                      # Khali => raw SIP media ke liye apna Asterisk/PJSIP chahiye
                      #          (warna handler 'not_configured' return karta hai).
#
# Note: koi bhi key set nahi => TelephonyService apne aap SIMULATION mode me chalega.

# ===========================================
# ===== WEBHOOKS / EVENTS =====
# External systems ko events notify karne ke liye (Retell/Vapi style webhooks).
# Jab pipeline me kuch hota hai — call.started, call.ended, lead.scraped,
# lead.qualified, appointment.booked, transfer.initiated, voicemail.detected,
# campaign.completed, error — to WebhookEmitter har subscriber URL par ek signed
# JSON envelope POST kar deta hai. Retry + exponential backoff (max 3) built-in.
#
# WEBHOOK_URLS: comma-separated endpoints jinhe sab events bhejne hain.
#   Khali chhodo => emit safe no-op ho jata hai (kuch nahi bhejta, sirf log).
#   Example: https://a.example.com/hooks,https://b.example.com/webhook
# ===========================================
WEBHOOK_URLS=

# WEBHOOK_SECRET: HMAC-SHA256 signing secret. Har POST ke `X-Signature` header me
# "sha256=<hex>" signature jaata hai. Receiver isi secret se verify kare
# (WebhookEmitter.verify_signature). Khali => signature header nahi bhejta.
WEBHOOK_SECRET=

# Optional tuning (defaults theek hain):
WEBHOOK_TIMEOUT_SECONDS=5    # per-request HTTP timeout (seconds)
WEBHOOK_MAX_RETRIES=3        # max attempts per URL (exponential backoff)

# ===== INDIAN LANGUAGE (Sarvam AI) — project ka India edge =====
# Sarvam = best Hindi/regional STT (Saaras) + TTS (Bulbul), 22 bhashayein,
# Hindi-English code-switching. Key na ho to free Vosk/EdgeTTS pe fallback.
SARVAM_API_KEY=                 # https://www.sarvam.ai se key
STT_PROVIDER=                   # "sarvam" Indian-lang ke liye; khali = free Vosk/Whisper
TTS_PROVIDER=                   # "sarvam" natural Hindi voice; khali = free EdgeTTS
LLM_PROVIDER=                   # "gemini" (free tier) recommended; khali = default
DEFAULT_LANGUAGE=hi-IN          # default call language
# AI4Bharat (open-source self-host alternative — optional)
AI4BHARAT_STT_URL=
AI4BHARAT_TTS_URL=

# ----- FREE self-host Hinglish STT (Sarvam-Saaras ka 100%-free alternative) -----
# Saaras khud self-host nahi hota (paid API). Yeh open Whisper-Hindi2Hinglish ko
# project ke maujooda faster-whisper runtime me load karta hai — ROMAN Hinglish
# output, koi recurring cost nahi. Model image me BAKED hai (Dockerfile.lock,
# scripts/build_hinglish_stt.sh). OFF = current weak whisper-base fallback.
HINGLISH_STT=                    # 1 = baked Hinglish model ko local STT banao; khali = whisper-base
HINGLISH_WHISPER_DIR=/opt/hinglish_whisper   # baked CT2 model dir (image me default yahi)
# VOBIZ_STT=whisper            # PHONE: local STT ko FORCE-PRIMARY karo (Groq/Gemini skip) — test/zero-cloud
# WEBCALL_STT_LOCAL_FIRST=1    # WEB: har web-call pe Hinglish model PRIMARY (cloud skip) — verify/zero-cloud mode
# FWHISPER_PROMPT=             # whisper initial_prompt override (khali = no prompt; default = sales-domain prime)
# FWHISPER_LANG=hi             # whisper force-language (default hi)

# ===========================================
# ===== AUTOMATION ENGINE FLAGS =====
# Yeh saare gated automation engines hain. DEFAULT = OFF (1/true se ON).
# FULL live registry: GET /api/growth/infra/flags  ·  detail: .claude/skills/automation-flags
# Source list: AUTOMATION_FLAGS in app/api/growth.py. Niche subset = sabse common.
# WARNING: kuch flags ban/cost-risk rakhte (WHATSAPP_AUTO_SEND, cold-calling) —
# enable karne se pehle automation-flags skill padho.
# ===========================================
# --- Scheduler core (PROD truth: in-process=0 + Celery worker/beat) ---
RUN_IN_PROCESS_SCHEDULER=1     # 1=APScheduler in web proc (dev). PROD=0 + celery beat.
ENABLE_LEGACY_BEAT=0           # 1 => legacy (non staff-*) beat entries on. Default sirf staff-* jobs.
CELERY_HEAVY_QUEUE=0           # 1 => heavy staff-jobs alag 'heavy' queue me (dedicated worker chahiye).
TEAM_AUTOMATION=1              # AI-staff scheduler master switch.

# --- Growth / outreach loops (revenue) ---
AUTO_EMAIL_OUTREACH=0          # Rohan roz 10:30 cold-email (cap 25/day, MX-verify). Email warmup recommended.
EMAIL_WARMUP=0                 # ramp send-volume; bounce auto-pause. WARMUP_START_DATE=YYYY-MM-DD.
OUTREACH_AB=0                  # subject-line A/B variants.
REPLY_AGENT=0                  # IMAP reply triage + Hinglish draft (auto-send OFF, ban-safe).
NICHE_ROTATION=0               # prospector 42-niche rotation.
LEAD_HARVESTER=0               # prospector + SearXNG/Brave + data.gov.in enrich.
JOURNEY_ENGINE=0               # per-lead multi-step journeys.
CADENCE_ENGINE=0               # omnichannel cadence drafts.
SALES_ENGINE=0                 # sales pipeline + auto-proposal + closer.
SALES_TEAM=0                   # 5-agent BANT deep-dive.
GROWTH_OPTIMIZER=0             # funnel-health driven optimizer.
CHANNEL_EXPERIMENTS=0          # 17 free-channel bandit (no auto-POST).
AUTO_ONBOARD=0                 # signup => website->KB seed + first content pack.

# --- Revenue / lifecycle ---
DUNNING_ENGINE=0               # failed-payment D0/3/7/14 emails.
LIFECYCLE_NURTURE=0
CLIENT_HEALTH_ALERTS=0
REVENUE_DIGEST=0
USAGE_ALERTS=0
AUTO_INVOICE=0
CRM_SYNC=0                     # qualified lead -> client Zoho/HubSpot push.

# --- Customer hands-free automations (per-client, DRAFT-only, ban-safe) ---
# Pricing "Hands-Free Automations" group ko literally chalane ke liye enable karo.
# Draft-safe / read-only (turant ON OK): BOOKING_REMINDERS, SERVICE_REMINDERS, REVIEW_MONITOR,
#   BRAND_PULSE, RANK_TRACKER, CUSTOMER_WISHES, NEWSLETTER_ENGINE, WINBACK_ENGINE, DELIVERABILITY_MONITOR, TEAM_REPORT.
# Send-capable (channel-creds pe hi send; soch ke ON): CADENCE_ENGINE, LIFECYCLE_NURTURE, SALES_ENGINE, JOURNEY_ENGINE.
BOOKING_REMINDERS=0            # booking se pehle reminder DRAFT.
SERVICE_REMINDERS=0           # repeat-service due reminder DRAFT.
REVIEW_MONITOR=0              # naye Google review -> AI reply DRAFT.
CUSTOMER_WISHES=0            # birthday/anniversary wish DRAFT.
EVERGREEN_RECYCLE=0          # purane top posts auto-freshen + re-queue (customer_autopilot).
NPS_AUTO=0                   # periodic NPS/CSAT survey DRAFTS (customer_autopilot).
STALE_INQUIRY_NUDGE=0        # untouched >24h inquiry -> follow-up nudge DRAFT (customer_autopilot).
OWNER_BRIEF_DAILY=0          # roz-subah per-client owner-brief auto-prepare (customer_autopilot).

# --- Self-improving / code ---
SELF_IMPROVE_LOOP=0            # task->task forever loop (Celery-requeue). Cost-cap built-in.
CODE_UPGRADER=0                # Vikram: free-LLM patch PROPOSALS (never auto-apply core).
SKILL_PACK=1                   # VPS agents skill find/snippet + KB skills ns.
AGENT_STANDUP=0               # Boss daily hierarchical coordination.

# --- Publishing (ban-risk: read skill first) ---
WHATSAPP_AUTO_SEND=0           # BAN-RISK: needs Cloud API + approved template. Keep 0.
MISSED_CALL_CALLBACK=0         # needs Vobiz DID + webhook (external-blocked).

# --- RAG / voice upgrades (heavy deps, opt-in) ---
USE_AGENTIC_RAG=0
USE_LIGHTRAG=0
USE_STRUCTURED_CONTENT=0
USE_SILERO_VAD=0               # turn-taking; heavy dep.
USE_SMART_TURN=0
SEMANTIC_CACHE=0
AGENT_MEMORY=0                 # cross-session per-lead/client memory (Qdrant+free LLM).
SESSION_MEMORY=0               # per-session ephemeral memory (Redis TTL, no Qdrant).
SESSION_MEMORY_TTL=7200        # session memory expiry in seconds (default 2h).
KB_SKILL_LEARN=0               # Hivemind: self_improve lessons + high-value runs → KB skills ns.
EVAL_KB_BOOST=0                # Deep Memory: positive eval hits → KB upsert (retrieval reinforce).
COORD_KB_SHARE=0               # Hivemind: coordinator executed-success → KB skills ns.

# --- LLM budget guards ---
LLM_BUDGET_GUARD=0             # per-scope daily cost cap + kill-switch (fail-open).
LLM_BUDGET_HARD_KILL=0         # emergency: block ALL LLM (fail-closed).

# ===========================================
# ===== OPTIONAL INFRA ADDONS (.env keys to activate) =====
# docker-compose.addons.yml: celery-exporter + flower + minio
# ===========================================
PLAN_RATE_LIMIT=0              # per-tier rate limit (Starter 60 / Growth 200 / Advanced 500 rpm).
ENABLE_OTEL=0                  # OpenTelemetry tracing -> Tempo.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
# Flower (Celery task UI) — docker-compose.addons.yml
FLOWER_USER=admin
FLOWER_PASSWORD=change-me
# MinIO / S3 (app/storage/minio_client.py — boto3; unset => local-disk fallback)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=leadgen
GRAFANA_PASSWORD=change-me
POSTHOG_API_KEY=
LITELLM_MASTER_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare Turnstile (bot-protection on public lead-magnet forms — F.1).
# Site-key = public (HTML widget). Secret = server-side siteverify.
# Both unset => bot-check INERT (today's behaviour). Both set => fail-CLOSED
# on missing/invalid token; fail-OPEN on Cloudflare infra error.
# Routes: /api/public/ai-demo /api/public/audit/score /api/public/inquiry /api/growth/tools/website-audit
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --------------------------------------------------------------------------- #
# F-M tracks — all default OFF / INERT. See docs/SESSION_ACTIVATION_RUNBOOK_2026_06_16.md
# --------------------------------------------------------------------------- #
# F.3 eval_gate (close-the-loop reward signal for self_improve + DeepEval CI)
EVAL_GATE=0
EVAL_GATE_HARD=0

# --- RL self-improvement flywheel (Phase 0) — reward spine, logging-only ---
# Master gate. OFF = no reward rows written, Stop hook no-op, /api/rl returns empty.
RL_ENGINE=0
RL_SUCCESS_THRESHOLD=0.5
RL_GRADUATION_N=200

# 2026-06-28 agent/queue governance guards (WORKFLOW_IMPROVEMENT_BACKLOG.md)
# 2026-07-01: armed by default (was 0=off) — coordinator's LLM calls (plan/coordinate/
# fan_out/reflect/debate), reachable via public /api/agents/council + hourly standup,
# had zero cost governance until an operator opted in. 60/min mirrors free-tier headroom;
# fail-open on cap (empty reply, callers already graceful) — set back to 0 to disable.
COORDINATOR_LLM_CAP_PER_MIN=60  # 0=off; >0 = coordinator LLM calls/min cap (over → skip, fail-open)
QUEUE_DEPTH_BACKPRESSURE=0      # 1 = DLQ retry-sweep defers when celery queue flooded (retry-storm guard)
QUEUE_DEPTH_CAP=800            # celery depth above which backpressure trips (when above flag on)

# F.5 engineer agents — Pranav SRE (hourly :45), Vidya FinOps (9-10am IST),
#                       Arnav Security (9:30-10:30am IST). Each INERT until set.
SRE_AGENT=0
FINOPS_AGENT=0
SECURITY_AGENT=0

# G.1 ops_alerts (ntfy fan-out — needs NTFY_URL + NTFY_TOPIC set below)
OPS_ALERTS=0
NTFY_URL=
NTFY_TOPIC=
# Sentry init requires ENVIRONMENT=production (Sentry probe surfaces this)
ENVIRONMENT=development
POSTHOG_HOST=https://us.i.posthog.com
# Optional tuning (defaults shown):
OPS_ALERT_ENGINEER_THRESHOLD=60
OPS_ALERT_EVAL_REJECT_BURST=3
OPS_ALERT_EVAL_REJECT_WINDOW=86400
OPS_ALERT_WEBHOOK_DEAD_LETTER_THRESHOLD=3

# H.1 customer-facing webhooks (Svix-style HMAC-SHA256 fan-out)
CUSTOMER_WEBHOOKS=0
# Leave SSRF deny-private ON (default); set 0 only for dev test endpoints.
CUSTOMER_WEBHOOK_DENY_PRIVATE=1

# H.2 customer-side 2FA — opt-in per customer; optional HMAC key for the
# login-challenge token. Unset = fresh random per process (fine for single-VPS).
TOTP_CHALLENGE_KEY=

# H.3 MCP-as-product + A2A Agent Card metered surface
MCP_PRODUCT=0

# council 2026-06-26 — Arya MCP Engineer (3-layer surface owner)
# Off by default; set =1 + restart for hourly health pulse + ntfy alerts.
MCP_ENGINEER=0
# /mcp expose gate — REQUIRED in production (ENV=production) for the mount to
# happen at all. Pick ONE (token is cleaner; allowlist works behind Caddy/CF).
FASTAPI_MCP_TOKEN=
MCP_IP_ALLOWLIST=
# Arya tunables (optional):
MCP_KEY_ROTATION_DAYS=90
MCP_QUOTA_PRESSURE_PCT=80
MCP_AUTH_FAIL_ALERT=20

# H.4 LiteLLM per-tenant cost (after docker compose -f docker-compose.edge.yml --profile gateway up -d)
LITELLM_COSTS=0
LITELLM_GATEWAY_URL=http://litellm:4000
# H.4 Warm-DR replica (Postgres logical-replication to free Neon/Supabase)
DR_REPLICA_URL=
DR_LAG_WARN_S=60
DR_LAG_FAIL_S=600

# F.4 agent_memory cross-session lead recall (Qdrant agent_memory collection)
AGENT_MEMORY=0
AGENT_MEMORY_MIN_SIM=0.35
AGENT_MEMORY_RECALL_LIMIT=4
AGENT_MEMORY_MAX_FACTS=4
# Optional: MEM0_BACKEND=mem0 (only if you `pip install mem0ai`); else native Qdrant.
MEM0_BACKEND=

# N.2 per-tenant feature-flags master gate (Redis-backed runtime store)
FEATURE_FLAGS=0

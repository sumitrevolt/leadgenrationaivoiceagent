# This file specifies files that are *not* uploaded to Cloud Build
.git
.gitignore
.vscode
__pycache__
*.pyc
*.pyo
*.egg-info
.env
.venv
venv
env
node_modules
frontend/node_modules
.terraform
*.tfstate*
tfplan*
.mypy_cache
.pytest_cache
.coverage
htmlcov
*.log
# Include data directory but exclude large files
!data
!data/**
data/leadgen_dev.db
data/*.db
data/*.sqlite
# tests/  <-- Allowing tests for Cloud Build
# docs/
*.md
!README.md
.DS_Store
*.swp
*.swo
infrastructure/terraform/.terraform
# Only exclude root-level models directory (ML models), NOT app/models
/models
auraleads_extracted/
revenue_pipeline/
frontend/
*.tmp
*.csv

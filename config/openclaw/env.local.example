# Local OpenClaw Gateway — Owner Copilot (DO NOT COMMIT SECRETS)
# Copy to config/openclaw/.env.local (gitignored) or export in shell.

# LeadGen Owner Copilot (inbound target)
LEADGEN_OWNER_COPILOT_URL=http://127.0.0.1:8000
OPENCLAW_API_TOKEN=REPLACE_WITH_LOCAL_DEV_TOKEN

# LeadGen must allowlist the Gateway peer (socket host). Loopback for same-host.
OPENCLAW_GATEWAY_ALLOWED_IPS=127.0.0.1,::1

# OpenClaw Gateway (loopback only — never public)
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_LOCAL_OPENCLAW_GATEWAY_TOKEN

# LeadGen feature flags for local proof only (do not set these in committed .env.example as ON)
# OPENCLAW_ENABLED=1
# OPENCLAW_ALLOW_RED_ACTIONS=0
# OPENCLAW_ALLOWED_COMMANDS=platform.status,agents.list,agent.status,approvals.list,delivery.status,queues.status,business.daily_summary,owner.next_actions

<?xml version="1.0"?>
<!-- Dialplan — outbound digits Vobiz gateway pe bridge, inbound/AI calls ESL socket (Pipecat) pe. -->
<include>
  <context name="leadgen-outbound">

    <!-- Inbound calls (gateway extension="ai_socket") + AI-handled legs → Python ESL socket.
         Pipecat/voice-pipeline 127.0.0.1:8084 pe outbound-socket server chalayega (next phase). -->
    <extension name="ai_socket">
      <condition field="destination_number" expression="^ai_socket$">
        <action application="answer"/>
        <action application="socket" data="127.0.0.1:8084 async full"/>
      </condition>
    </extension>

    <!-- Outbound PSTN: 10-15 digit number (optional +) → Vobiz trunk se bahar.
         DLT clear hone tak sirf own/known numbers pe test calls (transactional). -->
    <extension name="vobiz_outbound">
      <condition field="destination_number" expression="^(\+?\d{10,15})$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="origination_caller_id_number=$${vobiz_user}"/>
        <action application="bridge" data="sofia/gateway/vobiz/$1"/>
      </condition>
    </extension>

  </context>
</include>
